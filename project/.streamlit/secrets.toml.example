# Copy to .streamlit/secrets.toml (local) — NEVER commit secrets.toml
# Streamlit Cloud: paste equivalent keys in App Settings → Secrets

# ── Groq (operational AI interpreter — optional) ──
GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"
GROQ_TIMEOUT = "30"
GROQ_MAX_TOKENS = "2048"

# ── Twin runtime ──
TWIN_ENV = "production"
TWIN_LIGHT_SEED = "true"
TWIN_SEED_HISTORY_DAYS = "21"
TWIN_SEED_N_SKUS = "96"

# ── DuckDB (Cloud: use /tmp for ephemeral storage) ──
DUCKDB_PATH = "/tmp/warehouse.duckdb"
DUCKDB_THREADS = "2"
DUCKDB_MEMORY_LIMIT = "2GB"

# ── Logging ──
LOG_LEVEL = "INFO"
