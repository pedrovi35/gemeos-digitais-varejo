# Gêmeo Digital de Varejo — Local environment
# cp .env.example .env

# Groq API (optional — AI layer degrades gracefully offline)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30
GROQ_MAX_TOKENS=2048

# Runtime
TWIN_ENV=development
TWIN_LIGHT_SEED=false
TWIN_SEED_HISTORY_DAYS=60
TWIN_SEED_N_SKUS=240
TWIN_TIMEZONE=America/Sao_Paulo
TWIN_HORIZON_DAYS=14

# DuckDB
DUCKDB_PATH=./data/warehouse.duckdb
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=4GB

# Medallion lake
LAKE_BRONZE=./data/bronze
LAKE_SILVER=./data/silver
LAKE_GOLD=./data/gold

# Telemetry
LOG_LEVEL=INFO
LOG_PATH=./logs/twin.log
